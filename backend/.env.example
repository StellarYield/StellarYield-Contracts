# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins; defaults to * in development
ALLOWED_ORIGINS=
CORS_MAX_AGE=600

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Comma-separated fallback RPC endpoints (optional)
STELLAR_RPC_FALLBACKS=
# RPC call timeout in milliseconds (default: 10000, min: 1000)
STELLAR_RPC_TIMEOUT_MS=10000
# Log each RPC call's method, params and response size at debug level (#1206).
# URLs are logged by origin only, so API tokens are never written to logs.
# Default: false
RPC_DEBUG_LOG=false
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract addresses (fill in after deployment)
VAULT_FACTORY_CONTRACT_ID=
ZKME_VERIFIER_CONTRACT_ID=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellaryield
# Optional read replica — read-only queries from GET handlers are routed here.
# Falls back to DATABASE_URL when unset (#949).
DATABASE_READ_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stellaryield
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
# Queries slower than this many milliseconds are logged at warn level
DB_SLOW_QUERY_MS=500
# Connections opened upfront at startup so cold-start requests don't wait on
# connection setup under load (#951).
POOL_WARMUP_CONNECTIONS=3

# Indexer
INDEXER_START_LEDGER=0
INDEXER_POLL_INTERVAL_MS=5000
# Indexer lag alert threshold — error log emitted when indexer falls behind by more than this many ledgers
INDEXER_LAG_ALERT_LEDGERS=100
# Transfer alert thresholds
TRANSFER_VELOCITY_THRESHOLD=500
LARGE_TRANSFER_THRESHOLD=1000000

# Archival schedule (cron expression, default: 0 2 * * * = 2am daily)
ARCHIVE_CRON="0 2 * * *"

# API key inactivity deactivation (#934)
# Number of days an API key may go unused before the daily sweep deactivates it.
# Keys that have never been used are measured from their creation date.
# Leave unset (the default) to never deactivate keys automatically.
KEY_INACTIVITY_DAYS=

# Admin API — comma-separated CIDRs or IPs (optional)
# When set, only requests from these IPs can access /api/v1/admin/*
ADMIN_IP_ALLOWLIST=
ADMIN_API_KEY=your-admin-api-key-here

# Maximum size of an incoming JSON request body (e.g. "100kb", "1mb")
REQUEST_BODY_LIMIT=100kb

# Shared secret for HMAC-signed requests between internal services (/internal/* routes)
INTERNAL_SECRET=

# DB pool exhaustion alerting (#828)
# Log an error when more than this many connection requests are queued waiting for a pool slot.
# Default: 5. Set to 0 to disable.
DB_POOL_ALERT_WAITING=5

# RPC error rate alerting (#829)
# Log an error when the RPC error rate in a 5-minute window exceeds this percentage.
# Default: 10 (i.e. 10%). Range: 1–100.
RPC_ERROR_RATE_ALERT_PCT=10

# Redis connection used for caching and SSE replay-buffer durability (optional;
# caching/replay degrade gracefully to in-memory-only when unset)
REDIS_URL=

# Number of past vault SSE events buffered per vault for Last-Event-ID replay
# on reconnect (#761). Default: 100.
SSE_REPLAY_BUFFER=100

# Rate limiting
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=300
RATE_LIMIT_SIMULATE=30

# SMTP configuration for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Outbound API client (scripts/workers calling the API)
# Base URL the client calls. Defaults to http://localhost:$PORT when unset.
API_CLIENT_BASE_URL=
# Bearer API key attached to every outbound call (leave empty for anonymous)
API_CLIENT_API_KEY=
# Per-request timeout in milliseconds. Default: 10000. Set to 0 to disable.
API_CLIENT_TIMEOUT_MS=10000
# Retries after the first attempt, for idempotent methods. Default: 3.
API_CLIENT_MAX_RETRIES=3
# Longest a request may run before it gets a 503 with Retry-After. SSE streams
# are exempt. Default: 30000.
REQUEST_TIMEOUT_MS=30000
# Event loop p99 lag, in ms, above which non-essential requests are shed with
# a 503. /health, /metrics and /api/v1/admin are never shed. Default: 250.
LOAD_SHED_LAG_MS=250
